NODE materialize
DESCRIPTION >
    Monthly count of events per app

SQL >

    SELECT
        app_id,
        toStartOfMonth(timestamp) AS period,
        toStartOfDay(toTimeZone(ttl, 'UTC')) AS expires_at,
        toUInt8(1) AS retention_managed,
        countState() AS events
    FROM events
    GROUP BY
        app_id,
        period,
        expires_at,
        retention_managed

TYPE materialized
DATASOURCE monthly_usage_v1


