TOKEN "aptabase-api" READ

TOKEN "aptabase-admin" READ

NODE endpoint
SQL >

%
    SELECT replace(app_id, '_DEBUG', '') as AppId,
        countMerge(events) as Count
    FROM monthly_usage_v1
    WHERE period = {{String(period, '2025-11-01')}}
    GROUP BY replace(app_id, '_DEBUG', '')

TYPE endpoint

